<header class="z-50 w-full border-b border-b-gray-300">
    <div class="hidden lg:flex container mx-auto items-center justify-between px-4 py-6">
        <nav class="flex flex-row items-center gap-8" dir="ltr">
            <li class="list-none">
                <twig:Atoms:Link
                    href="#"
                    color="accent"
                    textSize="lg"
                >
                    {{ 'nav.home'|trans }}
                </twig:Atoms:Link>
            </li>
            <li class="list-none">
                <twig:Atoms:Link
                    href="#"
                    color="accent"
                    textSize="lg"
                >
                    {{ 'nav.search'|trans }}
                </twig:Atoms:Link>
            </li>
        </nav>
        <div class="flex items-center gap-4">
            {% if not app.user %}
                <twig:Atoms:Button
                    type="link"
                    variant="primary"
                    href="{{ path('auth_login') }}"
                >
                    {{ 'header.login'|trans }}
                </twig:Atoms:Button>
            {% else %}
                <twig:Atoms:Button
                    type="link"
                    variant="accent"
                    href="{{ path('auth_logout') }}"
                >
                    {{ 'header.logout'|trans }}
                </twig:Atoms:Button>
            {% endif %}
        </div>
    </div>
    <div
        class="flex lg:hidden container justify-between items-center p-4"
        data-controller="mobile-menu"
        data-action="keydown.esc@window->mobile-menu#close"
    >
        <span>Logo here</span>
        <button
            type="button"
            aria-label="{{ 'header.mobile_menu_button'|trans }}"
            aria-expanded="false"
            aria-controls="mobile-menu-panel"
            data-mobile-menu-target="button"
            data-action="mobile-menu#open"
        >
            <twig:ux:icon name="tabler:menu-2" class="h-6 w-6" />
        </button>
        <twig:organisms:mobile-menu></twig:organisms:mobile-menu>
    </div>
</header>