<div class="flex flex-row gap-16 items-center">
    <div class="flex-1 items-start">
        <form method="get" action="{{ path(route, routeParams|merge({ page: 1 })) }}">
            <twig:Atoms:Select
                id="limit"
                name="limit"
                label="{{ 'pagination.limit'|trans }}"
                :options="[
                    { label: '25', value: 25 },
                    { label: '50', value: 50 },
                    { label: '100', value: 100 }
                ]"
                value="{{ limit }}"
                :attributes="{ onchange: 'this.form.submit()' }"
            />
            {% for key, value in routeParams %}
                {% if key not in ['page', 'limit'] %}
                    <input type="hidden" name="{{ key }}" value="{{ value }}">
                {% endif %}
            {% endfor %}
        </form>
    </div>

    <div class="flex-11 flex justify-center">
        <div class="flex gap-6 items-center">
            <a
                href="{{ path(route, routeParams|merge({ page: 1 })) }}"
                class="w-9 h-9 flex items-center justify-center {{ page == 1 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100' }}"
                aria-label="{{ 'pagination.first'|trans }}"
            >
                <twig:ux:icon name="tabler:arrow-big-left-lines" class="size-5" />
            </a>

            <a
                href="{{ path(route, routeParams|merge({ page: page - 1 })) }}"
                class="w-9 h-9 flex items-center justify-center {{ page == 1 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100' }}"
                aria-label="{{ 'pagination.previous'|trans }}"
            >
                <twig:ux:icon name="tabler:arrow-big-left" class="size-5" />
            </a>

            {% for p in this.getPageRange() %}
                {% if p == '...' %}
                    <span class="w-9 h-9 flex items-center justify-center">...</span>
                {% else %}
                    <a
                        href="{{ path(route, routeParams|merge({ page: p })) }}"
                        class="w-9 h-9 flex items-center justify-center rounded {{ p == page ? 'bg-primary text-white' : 'hover:bg-gray-100' }}"
                    >
                        {{ p }}
                    </a>
                {% endif %}
            {% endfor %}

            <a
                href="{{ path(route, routeParams|merge({ page: page + 1 })) }}"
                class="w-9 h-9 flex items-center justify-center {{ page == this.getTotalPages() ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100' }}"
                aria-label="{{ 'pagination.next'|trans }}"
            >
                <twig:ux:icon name="tabler:arrow-big-right" class="size-5" />
            </a>

            <a
                href="{{ path(route, routeParams|merge({ page: this.getTotalPages() })) }}"
                class="w-9 h-9 flex items-center justify-center {{ page == this.getTotalPages() ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100' }}"
                aria-label="{{ 'pagination.last'|trans }}"
            >
                <twig:ux:icon name="tabler:arrow-big-right-lines" class="size-5" />
            </a>
        </div>
    </div>
</div>