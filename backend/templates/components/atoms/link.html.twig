<a
    href="{{ href }}"
    class="{{ "block p-0 text-#{textSize} group w-fit hover:text-#{color} transition-colors duration-400 #{classes}" }}"
    {{ attributes.without('classes', 'textSize', 'color', 'href') }}
>
    {% block content %}{% endblock %}
    <div class="bg-{{ color }} h-0.5 w-0 group-hover:w-full transition-all duration-400"></div>
</a>