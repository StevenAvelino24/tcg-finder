{% set baseClasses = "w-full rounded-4xl py-2 px-4 transition-colors duration-400 hover:cursor-pointer text-center" %}
{% set variantClasses = {
    primary: 'bg-primary text-secondary hover:bg-secondary hover:text-primary',
    secondary: 'bg-secondary text-white hover:bg-white hover:text-secondary',
    accent: 'bg-accent text-secondary hover:bg-secondary hover:text-accent'
} %}
{% if type === 'link' %}
    <a
        href="{{ href }}"
        class="{{ baseClasses ~ ' ' ~ variantClasses[variant] }}"
        {{ attributes.without('type', 'href', 'variant', 'classes') }}
    >
{% else %}
    <button
        type="{{ type }}"
        class="{{ baseClasses ~ ' ' ~ variantClasses[variant] }}"
        {{ attributes.without('type', 'href', 'variant', 'classes') }}
    >
{% endif %}
    {% block content %}{% endblock %}
{% if type === 'link' %}
    </a>
{% else %}
    </button>
{% endif %}
