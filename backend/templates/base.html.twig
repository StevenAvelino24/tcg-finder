<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}TCG Finder{% endblock %}</title>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div class="min-h-screen flex flex-col tracking-wide text-primary-text bg-gray-50">
            {{ include('components/organisms/header.html.twig') }}
            <main class="grow">
                <div class="container mx-auto px-4 py-8 sm:px-6 lg:px-8 max-w-7xl">
                    {% block main %}
                    {% endblock %}
                </div>
            </main>
            <footer>
                
            </footer>
        </div>
    </body>
</html>
