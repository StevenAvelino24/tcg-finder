{% extends 'base.html.twig' %}

{% block main %}
    <section class="space-y-8">
        <div class="max-w-md mx-auto text-center mb-16">
            <h1 class="text-3xl font-bold">{{ 'login.page.title'|trans }}</h1>
        </div>
        {% if error %}
            <div class="max-w-md mx-auto text-center bg-red-400 py-4 rounded-xl">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}
        <form class="max-w-md mx-auto space-y-6 p-6 bg-white rounded-xl shadow-md border border-primary" action="{{ path('auth_login') }}" method="post">
            <div class="flex flex-col space-y-2">
                <label for="username">{{ 'login.form.username'|trans }}</label>
                <input
                    type="email"
                    id="username"
                    name="_username"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 outline-none transition-all focus:ring-primary"
                    required
                />
            </div>
            <div class="flex flex-col space-y-2">
                <label for="password">{{ 'login.form.password'|trans }}</label>
                <input
                    type="password"
                    id="password"
                    name="_password"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 outline-none transition-all focus:ring-primary"
                    required
                />
            </div>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            <twig:atoms:button
                type="submit"
                variant="primary"
            >
                {{ 'login.form.submit'|trans }}
            </twig:atoms:button>
        </form>
    </section>
{% endblock %}