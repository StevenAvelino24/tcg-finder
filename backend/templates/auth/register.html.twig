{% extends 'base.html.twig' %}

{% block main %}
    <section class="space-y-8">
        {{ form_start(form, { attr: { class: 'max-w-md mx-auto space-y-6 p-6 bg-white rounded-xl shadow-md border border-primary', novalidate: 'novalidate' } }) }}
            <div class="flex flex-col py-4 pe-2">
                <h1 class="font-bold text-2xl text-center">{{ 'register.form.title'|trans }}</h1>
            </div>
            {{ form_errors(form) }}
            <div class="grid grid-cols-2 gap-4">
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
            </div>

            {{ form_row(form.email) }}

            {{ form_row(form.password.first) }}
            {{ form_row(form.password.second) }}

            <twig:atoms:button
                type="submit"
                variant="primary"
            >
                {{ 'register.form.submit'|trans }}
            </twig:atoms:button>
        {{ form_end(form) }}
    </section>
{% endblock %}